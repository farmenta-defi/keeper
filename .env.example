# Primary VPS scheduler only: database must be the shared farmenta database.
DATABASE_URL=postgres://farmenta_keeper:password@127.0.0.1:5432/farmenta
KEEPER_RPC_URL=
# 42069 is Ponder's default. Use the PORT from the indexer's own .env: on the shared VPS 42069
# belongs to another project's indexer.
KEEPER_INDEXER_URL=http://127.0.0.1:42069
KEEPER_PRIVATE_KEY=
KEEPER_TWAP_RECORDER=
KEEPER_MULTICALL3=
KEEPER_ETH_USD=2400
KEEPER_MAX_INDEXER_LAG_SECONDS=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backup GitHub Actions only: it deliberately has no DATABASE_URL or indexer URL.
KEEPER_BACKUP_PRIVATE_KEY=
KEEPER_COLLATERAL_POLICY=
KEEPER_POOL_MANAGER=
# CollateralPolicy deployment block: PoolListed and Recorded logs are read from here.
KEEPER_LOG_START_BLOCK=
# PoolManager deployment block (9070 on Robinhood Chain): listed pools may predate the policy.
KEEPER_POOL_MANAGER_START_BLOCK=

# The liquidation process runs under its own Unix user and wallet.
KEEPER_LIQUIDATOR_PRIVATE_KEY=

# Liquidation monitor.
KEEPER_CHAIN_ID=4663
KEEPER_RPC_COST_PATH=./rpc-cost.json
KEEPER_V4_QUOTER=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
KEEPER_USDG=0x5fc5360d0400a0fd4f2af552add042d716f1d168
# Pools the seized token may be sold through, as PoolKey objects with their id. The position's own
# pool is always a candidate too, except after a full seizure, which needs one of these.
KEEPER_ROUTE_POOLS_JSON=[]
# Floor of the swap against its quote, in basis points.
KEEPER_SLIPPAGE_BPS=50
KEEPER_MARKETS_JSON=
KEEPER_TREASURY=
KEEPER_POLL_INTERVAL_MS=2000
KEEPER_MAX_CALL_BATCH=100
KEEPER_MIN_GAS_BALANCE_WEI=10000000000000000
